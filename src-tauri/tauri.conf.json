{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stick AI",
  "version": "0.1.0",
  "identifier": "build.localilabs.stickai",
  "build": {
    "frontendDist": "../portable/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Your private local coding assistant",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
